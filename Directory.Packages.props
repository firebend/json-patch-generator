<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Framework-aligned packages ship a release line per .NET version, so each target framework
    gets its own version. To add a framework (for example net11.0), copy one of these blocks,
    change the condition, and set the matching 11.0.x versions.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.AspNetCore.JsonPatch" Version="9.0.20" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.JsonPatch" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <!-- Packages that are versioned independently of the .NET release. -->
  <ItemGroup>
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

</Project>
